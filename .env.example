# ============= FLASK & DATABASE =============

FLASK_ENV=production
SECRET_KEY=your-secret-key-here-min-32-chars-generate-new

DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# ============= STORAGE CONFIGURATION =============

# Image storage backend: 'local' or 'r2'
# - 'local': Saves to /app/static/uploads/ (default, immediate launch)
# - 'r2': Saves to Cloudflare R2 (for scale and backup)
#
# SWITCHING TO R2:
# 1. Set STORAGE_BACKEND=r2
# 2. Configure all R2_* variables below
# 3. Restart app
# 4. New uploads automatically go to R2
STORAGE_BACKEND=local

# Cloudflare R2 Configuration (only needed if STORAGE_BACKEND=r2)
# Leave blank for local storage
#
# R2_ACCESS_KEY
# Get from: Cloudflare Dashboard → R2 → Settings → API Tokens → Create API Token
# Permissions: Object Read & Write
R2_ACCESS_KEY=

# R2_SECRET_KEY
# Get from: Same place as R2_ACCESS_KEY
R2_SECRET_KEY=

# R2_BUCKET_NAME
# Example: 'fitness-brand-images'
R2_BUCKET_NAME=

# R2_ENDPOINT_URL
# Format: https://{account-id}.r2.cloudflarestorage.com
# Get account ID from: Cloudflare Dashboard → R2 → Settings
R2_ENDPOINT_URL=

# R2_PUBLIC_URL
# Public URL for accessing uploaded files
# Example: https://images.example.com (if using custom domain + CDN)
# Or: https://{bucket-name}.{account-id}.r2.cloudflarestorage.com
# Set this to your CDN URL for caching benefits
R2_PUBLIC_URL=

# ============= EMAIL CONFIGURATION (SMTP) =============

# Email backend: 'brevo', 'resend', 'mailgun', 'sendgrid', 'amazon_ses', or 'gmail'
# ⭐ RECOMMENDED: brevo (free tier: 9,000 emails/month)
MAIL_BACKEND=brevo

# ============= BREVO (RECOMMENDED - 9,000 free emails/month) =============
# 1. Sign up: https://app.brevo.com/
# 2. Go to: Settings → SMTP & API → SMTP
# 3. Copy SMTP Key
BREVO_API_KEY=xsmtpsib-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Email sender details (set in Brevo dashboard)
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME=Fitness Brand

# ============= ALTERNATIVE PROVIDERS (Choose ONE) =============

# Resend (Modern, 3,000 free/month)
# Get from: https://resend.com/api-keys
# RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Amazon SES (Pay-as-you-go: $0.10 per 1,000 emails)
# AWS_SES_REGION=us-east-1
# AWS_SES_SMTP_USERNAME=AKIAXXXXXXXXXXXXXXXX
# AWS_SES_SMTP_PASSWORD=your-ses-smtp-password

# Mailgun (3,000 free/month - not as generous)
# MAILGUN_DOMAIN=sandboxXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX.mailgun.org
# MAILGUN_API_KEY=key-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# SendGrid (3,000 free/month)
# SENDGRID_API_KEY=SG.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Gmail SMTP (ONLY for development/testing - NOT for production)
# GMAIL_ADDRESS=your-email@gmail.com
# GMAIL_APP_PASSWORD=your-16-char-app-password

# ============= APPLICATION SETTINGS =============

WHATSAPP_NUMBER=919876543210
INSTAGRAM_URL=https://www.instagram.com/dominate.cali

# ============= LOGGING (optional) =============

LOG_LEVEL=INFO

# ============= MONITORING (optional) =============

# Error tracking with Sentry (FUTURE)
# SENTRY_DSN=

# ============= REDIS (optional, for caching/sessions) =============

# REDIS_URL=redis://localhost:6379/0
