# ==============================================================================
# DOMINATE Flask Ecommerce - Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# APPLICATION
# ==============================================================================
FLASK_ENV=development
# Options: development, production, testing

# SECURITY - CRITICAL FOR PRODUCTION
# ==============================================================================
# Generate a strong SECRET_KEY:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-in-production

# DATABASE
# ==============================================================================
# For SQLite (development): sqlite:///instance/app.db (or leave empty for default)
# For PostgreSQL (production): postgresql://user:password@host:5432/database
DATABASE_URL=sqlite:///instance/app.db

# WHATSAPP BUSINESS
# ==============================================================================
# Your WhatsApp Business number for order confirmations
# Format: 91 (country code) + number without leading +
WHATSAPP_NUMBER=919876543210

# OPTIONAL: EMAIL NOTIFICATIONS (FUTURE)
# ==============================================================================
# Used for order confirmations, password resets, admin alerts
# Supports: Gmail, SendGrid, Mailgun, or any SMTP server

# Gmail Example (use app password, not account password)
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=True
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password

# SendGrid Example
# MAIL_SERVER=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_USE_TLS=True
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=your-sendgrid-api-key

# Email sender address
# MAIL_DEFAULT_SENDER=noreply@dominate.com

# OPTIONAL: AWS S3 (FUTURE - for image uploads)
# ==============================================================================
# AWS_S3_BUCKET=dominate-uploads
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_REGION=us-east-1

# OPTIONAL: ERROR TRACKING (FUTURE)
# ==============================================================================
# Sentry for real-time error tracking and monitoring
# SENTRY_DSN=https://your-key@sentry.io/project-id

# Log Analytics (for future monitoring)
# DATADOG_API_KEY=your-datadog-api-key
# NEW_RELIC_LICENSE_KEY=your-newrelic-license-key

# ==============================================================================
# SECURITY NOTES FOR PRODUCTION
# ==============================================================================
# 1. Set FLASK_ENV=production
# 2. Generate a strong SECRET_KEY (32+ random hex characters)
# 3. Use PostgreSQL (not SQLite)
# 4. Enable HTTPS (reverse proxy with Nginx)
# 5. Set strong database password
# 6. Configure email service for notifications
# 7. Enable error tracking (Sentry)
# 8. Set up log aggregation
# 9. Enable monitoring and alerting
# 10. Regular security audits and updates
